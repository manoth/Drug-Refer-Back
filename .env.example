# Web service
WEB_HOST=127.0.0.1
WEB_PORT=8765
AUTO_OPEN_BROWSER=true
AUTO_START_WINDOWS=true

# Set true only when the service is behind HTTPS.
SESSION_SECURE_COOKIE=false

# Local encrypted state and logs
WEB_STATE_FILE=data/web.db
AGENT_MASTER_KEY_FILE=data/master.key
POLLING_STATE_FILE=data/polling.db
REMOTE_QUERY_CACHE=data/remote-query-1.json
OUTPUT_JSONL=logs/post-preview.jsonl
SQL_FILE=sql.txt
QUERY_SOURCE=remote

# Agent behavior
POLL_SECONDS=5
VN_DEBOUNCE_SECONDS=3
MAX_VNS_PER_CYCLE=100
DB_QUERY_VN_BATCH_SIZE=25
DB_QUERY_RETRIES=2
DB_READ_TIMEOUT_SECONDS=120
API_POST_VN_BATCH_SIZE=25
QUERY_REFRESH_SECONDS=3600
LOOKBACK_DAYS=1
REQUIRE_SLAVE_HEALTH=false
DRY_RUN=false
API_TIMEOUT_SECONDS=20

# Database and API credentials are entered in the web setup.
API_BASE_URL=https://cpho.dentdata.net
API_QUERY_ID=2
API_TOKEN_HEADER=Authorization
API_TOKEN_SCHEME=Bearer
